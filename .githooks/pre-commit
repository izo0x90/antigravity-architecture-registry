#!/bin/sh
# Every commit: nothing that looks like a secret goes in (what's staged),
# and the Rust code is formatted.
# Tools: `make dev-setup`.
tools="${NAH_TOOLS:-$HOME/.local/bin}"
gitleaks="$(command -v gitleaks || echo "$tools/gitleaks")"
if [ ! -x "$gitleaks" ]; then
  echo "pre-commit: gitleaks isn't installed: run make dev-setup" >&2
  exit 1
fi
"$gitleaks" git --pre-commit --staged --redact --no-banner || exit 1
# And every Rust file formatted (rustfmt.toml); `cargo fmt` fixes it.
cd "$(git rev-parse --show-toplevel)/meta-harness" && cargo fmt --all --check >/dev/null || {
  echo "pre-commit: Rust files aren't formatted: run cargo fmt --all in meta-harness" >&2
  exit 1
}
