{
  "graph_style": {
    "back": {
      "loop": {
        "color": "warn",
        "dashed": true,
        "width": 1.2
      },
      "repeat": {
        "dashed": true,
        "width": 1.0
      }
    },
    "evidence": {
      "named": {
        "fade": 0.45,
        "width": 1.0
      }
    },
    "kinds": {
      "calls": "accent",
      "contains": "faint",
      "data_flow": "info",
      "implements": "special"
    },
    "lines": {
      "changed": {
        "color": "info",
        "width": 1.6
      },
      "code": {
        "width": 1.4
      },
      "done": {
        "color": "ok",
        "width": 1.6
      },
      "mismatch": {
        "color": "error",
        "dashed": true,
        "width": 1.8
      },
      "new": {
        "dashed": true,
        "width": 1.4
      }
    },
    "nodes": {
      "agent": "special",
      "fill": "card",
      "outline": {
        "changed": {
          "color": "info",
          "width": 1.6
        },
        "code": {
          "color": "border_strong",
          "width": 1.2
        },
        "done": {
          "color": "ok",
          "width": 1.4
        },
        "mismatch": {
          "color": "error",
          "width": 1.8
        },
        "new": {
          "color": "warn",
          "dashed": true,
          "width": 1.4
        }
      },
      "outside_plan_alpha": 0.55,
      "selected_fill": "card_selected",
      "selected_outline": "focus",
      "selected_width": 2.5
    },
    "pills": {
      "in": "info",
      "out": "ok",
      "step": "accent"
    }
  },
  "links": {
    "follow_debounce_ms": 250
  },
  "look": {
    "dash_speed": 18.0,
    "dim": 0.78,
    "fade": 0.6,
    "glow_alpha": 0.35,
    "glow_width": 6.0,
    "grid_step": 32.0,
    "line_bold": 2.0,
    "line_count_gain": 0.5,
